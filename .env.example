# Local development only. PostgreSQL is bound to loopback.
DATABASE_URL=postgresql://sgi:sgi_local_dev@localhost:54329/sgi_one
TEST_DATABASE_URL=postgresql://sgi:sgi_local_dev@localhost:54329/sgi_one_test
POSTGRES_USER=sgi
POSTGRES_PASSWORD=sgi_local_dev
POSTGRES_DB=sgi_one
BETTER_AUTH_URL=http://localhost:4310
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
# Required for private document upload/download and report photos. Never use NEXT_PUBLIC_.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sgi-one-private
# Demo seed requires an explicit password; never reuse a real password.
DEMO_PASSWORD=
DEMO_SEED_ENABLED=false

# Public map tile configuration only; never put R2/auth credentials here.
# Internet is required for tiles. Keep attribution visible; no offline/prefetch downloads.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
